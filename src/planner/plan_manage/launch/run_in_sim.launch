<launch>
  <!-- size of map, change the size inflate x, y, z according to your application -->
  <arg name="map_size_x"/>
  <arg name="map_size_y"/>
  <arg name="map_size_z"/>
  <arg name="init_x"/>
  <arg name="init_y"/>
  <arg name="init_z"/>
  <arg name="target_x"/>
  <arg name="target_y"/>
  <arg name="target_z"/>

  <arg name="drone_id"/>

  <arg name="malicious_drone_id" default="0" />
  <arg name="mal_type" default="0" />
  <arg name="lambda_adv_swarm" default="10.0"/>  <!-- lambda_adv_swarm -->
  <arg name="broadcast_offset_x" default="1.5" />
  <arg name="broadcast_offset_y" default="2.0" />
  <arg name="broadcast_offset_z" default="0.0" />
  <arg name="phantom_fake_drone_id" default="11"/>
  <arg name="phantom_z_offset" default="0.0"/>
  <arg name="phantom_samples" default="10"/>
  <arg name="phantom_radius" default="2.0"/>
  <arg name="phantom_time_offset" default="2.0"/>
  <arg name="phantom_dt" default="0.2"/>
  <arg name="phantom_shape" default="circle"/>
  <arg name="phantom_target_drone_id" default="5"/>

  <!-- Phantom attack experiment args -->
  <arg name="attack_enable" default="false"/>
  <arg name="attack_method" default="benign"/>
  <arg name="attack_method_id" default="0"/>
  <arg name="attack_malicious_drone_id" default="0"/>
  <arg name="attack_victim_drone_id" default="9"/>
  <arg name="attack_phantom_fake_drone_id" default="-1"/>
  <arg name="attack_window_enable" default="false"/>
  <arg name="attack_start_time" default="0.0"/>
  <arg name="attack_duration" default="9999.0"/>
  <arg name="attack_max_offset_radius" default="2.5"/>
  <arg name="attack_direction_samples" default="16"/>
  <arg name="attack_radius_samples" default="5"/>
  <arg name="attack_horizon" default="5.0"/>
  <arg name="attack_dt" default="0.1"/>
  <arg name="attack_clearance" default="0.5"/>
  <arg name="attack_continuity_enable" default="true"/>
  <arg name="attack_smoothing_time" default="1.0"/>
  <arg name="attack_max_offset_rate" default="0.6"/>
  <arg name="attack_ramp_ctrl_pts" default="5"/>
  <arg name="attack_ramp_power" default="1.0"/>
  <arg name="attack_max_vel_check" default="3.0"/>
  <arg name="attack_max_acc_check" default="4.0"/>
  <arg name="attack_max_jerk_check" default="8.0"/>
  <arg name="experiment_log_enable" default="true"/>
  <arg name="experiment_log_file" default="$(env HOME)/ego_phantom_trial_summary.csv"/>
  <!-- Accepted for swarm launch compatibility; each swarm include already
       resolves experiment_log_file to its drone-specific CSV path. -->
  <arg name="experiment_per_uav_log_enable" default="true"/>
  <arg name="experiment_per_uav_log_file" default="$(env HOME)/ego_phantom_per_uav_summary.csv"/>
  <arg name="experiment_timeseries_log_file" default="$(env HOME)/ego_phantom_timeseries.csv"/>
  <arg name="experiment_timeseries_log_enable" default="true"/>
  <arg name="experiment_timeseries_interval" default="0.2"/>
  <arg name="experiment_scenario" default="unknown"/>
  <arg name="experiment_seed" default="0"/>
  <arg name="experiment_swarm_size" default="10"/>
  <arg name="experiment_attacker_count" default="1"/>
  <!-- Additional swarm/attack controls accepted from swarm_30/50.launch. -->
  <arg name="attack_scenario" default="random"/>
  <arg name="attack_scenario_id" default="1"/>
  <arg name="attack_swarm_weight" default="2.0"/>
  <arg name="attack_scenario_weight" default="2.0"/>
  <arg name="attack_impact_distance_weight" default="0.25"/>
  <arg name="attack_offset_penalty_weight" default="0.005"/>
  <arg name="attack_herding_weight" default="1.0"/>
  <arg name="attack_trap_weight" default="1.0"/>
  <arg name="attack_oscillation_weight" default="1.0"/>
  <arg name="attack_herding_direction_x" default="0.0"/>
  <arg name="attack_herding_direction_y" default="1.0"/>
  <arg name="attack_herding_direction_z" default="0.0"/>
  <arg name="attack_use_manual_trap_exit" default="false"/>
  <arg name="attack_trap_exit_x" default="0.0"/>
  <arg name="attack_trap_exit_y" default="0.0"/>
  <arg name="attack_trap_exit_z" default="1.0"/>
  <arg name="attack_trap_exit_radius" default="1.5"/>
  <arg name="attack_use_manual_goal" default="false"/>
  <arg name="attack_goal_x" default="0.0"/>
  <arg name="attack_goal_y" default="0.0"/>
  <arg name="attack_goal_z" default="1.0"/>
  <arg name="attack_goal_region_radius" default="2.0"/>
  <arg name="attack_oscillation_period" default="2.0"/>
  <arg name="attack_preserve_fake_ratio" default="0.7"/>
  <arg name="experiment_trial_id" default="trial_0"/>
  <arg name="experiment_map" default="unknown"/>
  <arg name="experiment_comm_radius" default="-1.0"/>
  <arg name="experiment_sharing_freq" default="-1.0"/>
  <arg name="experiment_log_owner_drone_id" default="-9999"/>

  <!-- topic of your odometry such as VIO or LIO -->
  <arg name="odom_topic"/>

  <!-- number of moving objects -->
  <arg name="obj_num" value="10" />

  <!-- main algorithm params -->
  <include file="$(find ego_planner)/launch/advanced_param.xml">

    <arg name="drone_id" value="$(arg drone_id)"/>

    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>

    <arg name="obj_num_set" value="$(arg obj_num)" />

    <!-- camera pose: transform of camera frame in the world frame -->
    <!-- depth topic: depth image, 640x480 by default -->
    <!-- don't set cloud_topic if you already set these ones! -->
    <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
    <arg name="depth_topic" value="pcl_render_node/depth"/>

    <!-- topic of point cloud measurement, such as from LIDAR  -->
    <!-- don't set camera pose and depth, if you already set this one! -->
    <arg name="cloud_topic" value="pcl_render_node/cloud"/>

    <!-- intrinsic params of the depth camera -->
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>

    <!-- maximum velocity and acceleration the drone will reach -->
    <arg name="max_vel" value="2.0" />
    <arg name="max_acc" value="3.0" />

    <!--always set to 1.5 times grater than sensing horizen-->
    <arg name="planning_horizon" value="7.5" /> 

    <arg name="use_distinctive_trajs" value="true" />

    <!-- 1: use 2D Nav Goal to select goal  -->
    <!-- 2: use global waypoints below  -->
    <arg name="flight_type" value="2" />
    
    <!-- global waypoints -->
    <!-- It generates a piecewise min-snap traj passing all waypoints -->
    <arg name="point_num" value="1" />

    <arg name="point0_x" value="$(arg target_x)" />
    <arg name="point0_y" value="$(arg target_y)" />
    <arg name="point0_z" value="$(arg target_z)" />

    <arg name="point1_x" value="0.0" />
    <arg name="point1_y" value="15.0" />
    <arg name="point1_z" value="1.0" />

    <arg name="point2_x" value="15.0" />
    <arg name="point2_y" value="0.0" />
    <arg name="point2_z" value="1.0" />

    <arg name="point3_x" value="0.0" />
    <arg name="point3_y" value="-15.0" />
    <arg name="point3_z" value="1.0" />

    <arg name="point4_x" value="-15.0" />
    <arg name="point4_y" value="0.0" />
    <arg name="point4_z" value="1.0" />

    <arg name="malicious_drone_id" value="$(arg malicious_drone_id)" type="int"/>
    <arg name="broadcast_offset_x" value="$(arg broadcast_offset_x)" type="double"/>
    <arg name="broadcast_offset_y" value="$(arg broadcast_offset_y)" type="double"/>
    <arg name="broadcast_offset_z" value="$(arg broadcast_offset_z)" type="double"/>
    <arg name="mal_type" value="$(arg mal_type)" type="int"/>
    <arg name="lambda_adv_swarm" value="$(arg lambda_adv_swarm)" type="double"/>
    <arg name="phantom_fake_drone_id" value="$(arg phantom_fake_drone_id)" type="int"/>
    <arg name="phantom_shape" value="$(arg phantom_shape)" />
    <arg name="phantom_radius" value="$(arg phantom_radius)" type="double"/>
    <arg name="phantom_samples" value="$(arg phantom_samples)" type="int"/>
    <arg name="phantom_dt" value="$(arg phantom_dt)" type="double"/>
    <arg name="phantom_z_offset" value="$(arg phantom_z_offset)" type="double"/>
    <arg name="phantom_target_drone_id" value="$(arg phantom_target_drone_id)" type="int"/>
    <arg name="phantom_time_offset" value="$(arg phantom_time_offset)" type="double"/>
    <!-- Forward phantom attack experiment args -->
    <arg name="attack_enable" value="$(arg attack_enable)"/>
    <arg name="attack_method" value="$(arg attack_method)"/>
    <arg name="attack_method_id" value="$(arg attack_method_id)"/>
    <arg name="attack_malicious_drone_id" value="$(arg attack_malicious_drone_id)"/>
    <arg name="attack_victim_drone_id" value="$(arg attack_victim_drone_id)"/>
    <arg name="attack_phantom_fake_drone_id" value="$(arg attack_phantom_fake_drone_id)"/>
    <arg name="attack_window_enable" value="$(arg attack_window_enable)"/>
    <arg name="attack_start_time" value="$(arg attack_start_time)"/>
    <arg name="attack_duration" value="$(arg attack_duration)"/>
    <arg name="attack_max_offset_radius" value="$(arg attack_max_offset_radius)"/>
    <arg name="attack_direction_samples" value="$(arg attack_direction_samples)"/>
    <arg name="attack_radius_samples" value="$(arg attack_radius_samples)"/>
    <arg name="attack_horizon" value="$(arg attack_horizon)"/>
    <arg name="attack_dt" value="$(arg attack_dt)"/>
    <arg name="attack_clearance" value="$(arg attack_clearance)"/>
    <arg name="attack_continuity_enable" value="$(arg attack_continuity_enable)"/>
    <arg name="attack_smoothing_time" value="$(arg attack_smoothing_time)"/>
    <arg name="attack_max_offset_rate" value="$(arg attack_max_offset_rate)"/>
    <arg name="attack_ramp_ctrl_pts" value="$(arg attack_ramp_ctrl_pts)"/>
    <arg name="attack_ramp_power" value="$(arg attack_ramp_power)"/>
    <arg name="attack_max_vel_check" value="$(arg attack_max_vel_check)"/>
    <arg name="attack_max_acc_check" value="$(arg attack_max_acc_check)"/>
    <arg name="attack_max_jerk_check" value="$(arg attack_max_jerk_check)"/>
    <arg name="experiment_log_enable" value="$(arg experiment_log_enable)"/>
    <arg name="experiment_log_file" value="$(arg experiment_log_file)"/>
    <arg name="experiment_per_uav_log_file" value="$(arg experiment_per_uav_log_file)"/>
    <arg name="experiment_per_uav_log_enable" value="$(arg experiment_per_uav_log_enable)"/>
    <arg name="experiment_timeseries_log_file" value="$(arg experiment_timeseries_log_file)"/>
    <arg name="experiment_timeseries_log_enable" value="$(arg experiment_timeseries_log_enable)"/>
    <arg name="experiment_timeseries_interval" value="$(arg experiment_timeseries_interval)"/>
    <arg name="experiment_scenario" value="$(arg experiment_scenario)"/>
    <arg name="experiment_seed" value="$(arg experiment_seed)"/>
    <arg name="experiment_swarm_size" value="$(arg experiment_swarm_size)"/>
    <arg name="experiment_attacker_count" value="$(arg experiment_attacker_count)"/>

  </include>

  <!-- trajectory server -->
  <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
    <remap from="position_cmd" to="drone_$(arg drone_id)_planning/pos_cmd"/>
    <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>

    <param name="traj_server/time_forward" value="1.0" type="double"/>
  </node>

  <!--node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>        
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger" />
    <param name="waypoint_type" value="manual-lonely-waypoint"/>    
  </node-->

  <!-- use simulator -->
  <include file="$(find ego_planner)/launch/simulator.xml">

    <arg name="drone_id" value="$(arg drone_id)"/>

    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>

    <arg name="init_x_" value="$(arg init_x)"/>
    <arg name="init_y_" value="$(arg init_y)"/>
    <arg name="init_z_" value="$(arg init_z)"/>

    <arg name="odometry_topic" value="$(arg odom_topic)" />
  </include>

  <![CDATA[node pkg="plan_env" name="obj_generator" type="obj_generator" output="screen">
    <param name="obj_generator/obj_num" value="$(arg obj_num)"/>    
    <param name="obj_generator/x_size" value="12.0"/>  
    <param name="obj_generator/y_size" value="12.0"/>  
    <param name="obj_generator/h_size" value="1.0"/>   
    <param name="obj_generator/vel" value="1.5"/>   
    <param name="obj_generator/yaw_dot" value="2.0"/>   
    <param name="obj_generator/acc_r1" value="1.0"/>   
    <param name="obj_generator/acc_r2" value="1.0"/>   
    <param name="obj_generator/acc_z" value="0.0"/>   
    <param name="obj_generator/scale1" value="0.5"/>   
    <param name="obj_generator/scale2" value="1.0"/>   
    <param name="obj_generator/interval" value="100.0"/>    
    <param name="obj_generator/input_type" value="1"/> <!-- 1: Vel input, 2: Acc input-->>   
  </node]]>

</launch>
