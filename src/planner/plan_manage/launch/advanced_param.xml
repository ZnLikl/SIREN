<launch>
  <arg name="map_size_x_"/>
  <arg name="map_size_y_"/>
  <arg name="map_size_z_"/>

  <arg name="odometry_topic"/>
  <arg name="camera_pose_topic"/>
  <arg name="depth_topic"/>
  <arg name="cloud_topic"/>

  <arg name="cx"/>
  <arg name="cy"/>
  <arg name="fx"/>
  <arg name="fy"/>

  <arg name="max_vel"/>
  <arg name="max_acc"/>
  <arg name="planning_horizon"/>

  <arg name="point_num"/>
  <arg name="point0_x"/>
  <arg name="point0_y"/>
  <arg name="point0_z"/>
  <arg name="point1_x"/>
  <arg name="point1_y"/>
  <arg name="point1_z"/>
  <arg name="point2_x"/>
  <arg name="point2_y"/>
  <arg name="point2_z"/>
  <arg name="point3_x"/>
  <arg name="point3_y"/>
  <arg name="point3_z"/>
  <arg name="point4_x"/>
  <arg name="point4_y"/>
  <arg name="point4_z"/>

  <arg name="flight_type"/>
  <arg name="use_distinctive_trajs"/>

  <arg name="obj_num_set"/>

  <arg name="drone_id"/>
  <arg name="exp_log_file" default="$(env HOME)/ego_log_uav$(arg drone_id).csv"/>

  <arg name="malicious_drone_id" default="0"/>
  <arg name="mal_type" default="0"/>
  <arg name="lambda_adv_swarm" default="10.0"/> <!-- swarm cost 权重 -->

  <arg name="broadcast_offset_x" default="1.5"/>
  <arg name="broadcast_offset_y" default="2.0"/>
  <arg name="broadcast_offset_z" default="0.0"/>
  <arg name="phantom_fake_drone_id" default="11"/>
  <arg name="phantom_z_offset" default="0.0"/>
  <arg name="phantom_samples" default="10"/>               <!-- 控制点数量 -->
  <arg name="phantom_radius" default="2.0"/>               <!-- 幻影轨迹半径 -->
  <arg name="phantom_time_offset" default="2.0"/>          <!-- 延时 -->
  <arg name="phantom_dt" default="0.2"/>                   <!-- 时间间隔 -->
  <arg name="phantom_shape" default="circle"/>             <!-- 形状，可选 circle / line / static -->
  <arg name="phantom_target_drone_id" default="5"/>        <!-- 哪架无人机附近生成 -->


  <!-- ================= Phantom trajectory attack experiment args ================= -->
  <arg name="attack_enable" default="false"/>
  <!-- benign | random_fake | no_temporal_refresh | no_impact_objective | full_attack | naive_infeasible -->
  <arg name="attack_method" default="benign"/>
  <arg name="attack_method_id" default="0"/>
  <arg name="attack_malicious_drone_id" default="0"/>
  <arg name="attack_victim_drone_id" default="9"/>
  <arg name="attack_phantom_fake_drone_id" default="-1"/>
  <arg name="attack_window_enable" default="false"/>
  <arg name="attack_start_time" default="0.0"/>
  <arg name="attack_duration" default="9999.0"/>
  <arg name="attack_max_offset_radius" default="2.5"/>
  <arg name="attack_direction_samples" default="16"/>
  <arg name="attack_radius_samples" default="5"/>
  <arg name="attack_horizon" default="5.0"/>
  <arg name="attack_dt" default="0.1"/>
  <arg name="attack_clearance" default="0.5"/>
  <arg name="attack_continuity_enable" default="true"/>
  <arg name="attack_smoothing_time" default="1.0"/>
  <arg name="attack_max_offset_rate" default="0.6"/>
  <arg name="attack_ramp_ctrl_pts" default="5"/>
  <arg name="attack_ramp_power" default="1.0"/>
  <arg name="attack_max_vel_check" default="3.0"/>
  <arg name="attack_max_acc_check" default="4.0"/>
  <arg name="attack_max_jerk_check" default="8.0"/>

  <arg name="experiment_log_enable" default="true"/>
  <arg name="experiment_log_file" default="$(env HOME)/ego_phantom_trial_summary.csv"/>
  <arg name="experiment_per_uav_log_file" default="$(env HOME)/ego_phantom_per_uav_summary.csv"/>
  <arg name="experiment_per_uav_log_enable" default="true"/>
  <arg name="experiment_timeseries_log_file" default="$(env HOME)/ego_phantom_timeseries.csv"/>
  <arg name="experiment_timeseries_log_enable" default="true"/>
  <arg name="experiment_timeseries_interval" default="0.2"/>
  <arg name="experiment_scenario" default="unknown"/>
  <arg name="experiment_seed" default="0"/>
  <arg name="experiment_swarm_size" default="10"/>
  <arg name="experiment_attacker_count" default="1"/>

  <!-- main node -->
  <!-- <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen" launch-prefix="valgrind"> -->
  <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner_node" type="ego_planner_node" output="screen">
  
    <remap from="~odom_world" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
    <remap from="~planning/bspline" to = "/drone_$(arg drone_id)_planning/bspline"/>
    <remap from="~planning/data_display" to = "/drone_$(arg drone_id)_planning/data_display"/>
    <remap from="~planning/broadcast_bspline_from_planner" to = "/broadcast_bspline"/>
    <remap from="~planning/broadcast_bspline_to_planner" to = "/broadcast_bspline"/>

    <remap from="~grid_map/odom" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
    <remap from="~grid_map/cloud" to="/drone_$(arg drone_id)_$(arg cloud_topic)"/>
    <remap from="~grid_map/pose"   to = "/drone_$(arg drone_id)_$(arg camera_pose_topic)"/> 
    <remap from="~grid_map/depth" to = "/drone_$(arg drone_id)_$(arg depth_topic)"/>
    

    <!-- planning fsm -->
    <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
    <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
    <param name="fsm/thresh_no_replan_meter" value="1.0" type="double"/>
    <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/> <!--always set to 1.5 times grater than sensing horizen-->
    <param name="fsm/planning_horizen_time" value="3" type="double"/>
    <param name="fsm/emergency_time" value="1.0" type="double"/>
    <param name="fsm/realworld_experiment" value="false"/>
    <param name="fsm/fail_safe" value="true"/>

    <param name="fsm/waypoint_num" value="$(arg point_num)" type="int"/>
    <param name="fsm/waypoint0_x" value="$(arg point0_x)" type="double"/>
    <param name="fsm/waypoint0_y" value="$(arg point0_y)" type="double"/>
    <param name="fsm/waypoint0_z" value="$(arg point0_z)" type="double"/>
    <param name="fsm/waypoint1_x" value="$(arg point1_x)" type="double"/>
    <param name="fsm/waypoint1_y" value="$(arg point1_y)" type="double"/>
    <param name="fsm/waypoint1_z" value="$(arg point1_z)" type="double"/>
    <param name="fsm/waypoint2_x" value="$(arg point2_x)" type="double"/>
    <param name="fsm/waypoint2_y" value="$(arg point2_y)" type="double"/>
    <param name="fsm/waypoint2_z" value="$(arg point2_z)" type="double"/>
    <param name="fsm/waypoint3_x" value="$(arg point3_x)" type="double"/>
    <param name="fsm/waypoint3_y" value="$(arg point3_y)" type="double"/>
    <param name="fsm/waypoint3_z" value="$(arg point3_z)" type="double"/>
    <param name="fsm/waypoint4_x" value="$(arg point4_x)" type="double"/>
    <param name="fsm/waypoint4_y" value="$(arg point4_y)" type="double"/>
    <param name="fsm/waypoint4_z" value="$(arg point4_z)" type="double"/>

    <param name="grid_map/resolution"      value="0.1" /> 
    <param name="grid_map/map_size_x"   value="$(arg map_size_x_)" /> 
    <param name="grid_map/map_size_y"   value="$(arg map_size_y_)" /> 
    <param name="grid_map/map_size_z"   value="$(arg map_size_z_)" /> 
    <param name="grid_map/local_update_range_x"  value="5.5" /> 
    <param name="grid_map/local_update_range_y"  value="5.5" /> 
    <param name="grid_map/local_update_range_z"  value="4.5" /> 
    <param name="grid_map/obstacles_inflation"     value="0.099" /> 
    <param name="grid_map/local_map_margin" value="10"/>
    <param name="grid_map/ground_height"        value="-0.01"/>
    <!-- camera parameter -->
    <param name="grid_map/cx" value="$(arg cx)"/>
    <param name="grid_map/cy" value="$(arg cy)"/>
    <param name="grid_map/fx" value="$(arg fx)"/>
    <param name="grid_map/fy" value="$(arg fy)"/>
    <!-- depth filter -->
    <param name="grid_map/use_depth_filter" value="true"/>
    <param name="grid_map/depth_filter_tolerance" value="0.15"/>
    <param name="grid_map/depth_filter_maxdist"   value="5.0"/>
    <param name="grid_map/depth_filter_mindist"   value="0.2"/>
    <param name="grid_map/depth_filter_margin"    value="2"/>
    <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
    <param name="grid_map/skip_pixel" value="2"/>
    <!-- local fusion -->
    <param name="grid_map/p_hit"  value="0.65"/>
    <param name="grid_map/p_miss" value="0.35"/>
    <param name="grid_map/p_min"  value="0.12"/>
    <param name="grid_map/p_max"  value="0.90"/>
    <param name="grid_map/p_occ"  value="0.80"/>
    <param name="grid_map/min_ray_length" value="0.1"/>
    <param name="grid_map/max_ray_length" value="4.5"/>

    <param name="grid_map/virtual_ceil_height"   value="2.9"/>
    <param name="grid_map/visualization_truncate_height"   value="1.8"/>
    <param name="grid_map/show_occ_time"  value="false"/>
    <param name="grid_map/pose_type"     value="1"/>  
    <param name="grid_map/frame_id"      value="world"/>

  <!-- planner manager -->
    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="manager/max_jerk" value="4" type="double"/>
    <param name="manager/control_points_distance" value="0.4" type="double"/>
    <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
    <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <param name="manager/use_distinctive_trajs" value="$(arg use_distinctive_trajs)" type="bool"/>
    <param name="manager/drone_id" value="$(arg drone_id)"/>
    <param name="exp_log_file" value="$(arg exp_log_file)"/>
    
  <!-- trajectory optimization -->
    <param name="optimization/lambda_smooth" value="1.0" type="double"/>
    <param name="optimization/lambda_collision" value="0.5" type="double"/>
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <param name="optimization/dist0" value="0.5" type="double"/>
    <param name="optimization/swarm_clearance" value="0.5" type="double"/>
    <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>

    <!-- Swarm cost 权重 -->
    <param name="optimization/lambda_adv_swarm" value="$(arg lambda_adv_swarm)" type="double"/>

    <param name="bspline/limit_vel" value="$(arg max_vel)" type="double"/>
    <param name="bspline/limit_acc" value="$(arg max_acc)" type="double"/>
    <param name="bspline/limit_ratio" value="1.1" type="double"/>

  <!-- objects prediction -->
    <param name="prediction/obj_num" value="$(arg obj_num_set)" type="int"/>
    <param name="prediction/lambda" value="1.0" type="double"/>
    <param name="prediction/predict_rate" value="1.0" type="double"/>
  
  <!-- traj server -->
    <param name="malicious_drone_id" value="$(arg malicious_drone_id)" type="int"/>
    <param name="mal_type" value="$(arg mal_type)" type="int"/>
    <param name="broadcast_offset_x" value="$(arg broadcast_offset_x)" type="double"/>
    <param name="broadcast_offset_y" value="$(arg broadcast_offset_y)" type="double"/>
    <param name="broadcast_offset_z" value="$(arg broadcast_offset_z)" type="double"/>
    <param name="phantom_fake_drone_id" value="$(arg phantom_fake_drone_id)" type="int"/>
    <param name="phantom_z_offset" value="$(arg phantom_z_offset)" type="double"/>
    <param name="phantom_target_drone_id" value="$(arg phantom_target_drone_id)" type="int"/>
    
    <param name="phantom_samples" value="$(arg phantom_samples)" type="int"/>
    <param name="phantom_dt"      value="$(arg phantom_dt)"      type="double"/>
    <param name="phantom_shape"   value="$(arg phantom_shape)"   type="string"/>
    <param name="phantom_time_offset" value="$(arg phantom_time_offset)" type="double"/>


    <!-- ================= Phantom trajectory attack experiment params =================
         These parameters are read by PhantomAttackGenerator and ExperimentTrialLogger.
         The attack modifies only the trajectory that the malicious UAV broadcasts.
         The real local trajectory executed by the malicious UAV is not changed. -->
    <param name="attack/enable" value="$(arg attack_enable)" type="bool"/>
    <param name="attack/method" value="$(arg attack_method)" type="string"/>
    <param name="attack/method_id" value="$(arg attack_method_id)" type="int"/>
    <param name="attack/malicious_drone_id" value="$(arg attack_malicious_drone_id)" type="int"/>
    <param name="attack/victim_drone_id" value="$(arg attack_victim_drone_id)" type="int"/>
    <param name="attack/phantom_fake_drone_id" value="$(arg attack_phantom_fake_drone_id)" type="int"/>
    <param name="attack/window_enable" value="$(arg attack_window_enable)" type="bool"/>
    <param name="attack/start_time" value="$(arg attack_start_time)" type="double"/>
    <param name="attack/duration" value="$(arg attack_duration)" type="double"/>

    <!-- Offset candidate generation. fixed_offset_* is also used as the no-impact baseline. -->
    <param name="attack/fixed_offset_x" value="$(arg broadcast_offset_x)" type="double"/>
    <param name="attack/fixed_offset_y" value="$(arg broadcast_offset_y)" type="double"/>
    <param name="attack/fixed_offset_z" value="$(arg broadcast_offset_z)" type="double"/>
    <param name="attack/max_offset_radius" value="$(arg attack_max_offset_radius)" type="double"/>
    <param name="attack/direction_samples" value="$(arg attack_direction_samples)" type="int"/>
    <param name="attack/radius_samples" value="$(arg attack_radius_samples)" type="int"/>
    <param name="attack/horizon" value="$(arg attack_horizon)" type="double"/>
    <param name="attack/dt" value="$(arg attack_dt)" type="double"/>
    <param name="attack/clearance" value="$(arg attack_clearance)" type="double"/>

    <!-- Continuity and physical consistency constraints. -->
    <param name="attack/continuity_enable" value="$(arg attack_continuity_enable)" type="bool"/>
    <param name="attack/smoothing_time" value="$(arg attack_smoothing_time)" type="double"/>
    <param name="attack/max_offset_rate" value="$(arg attack_max_offset_rate)" type="double"/>
    <param name="attack/ramp_ctrl_pts" value="$(arg attack_ramp_ctrl_pts)" type="int"/>
    <param name="attack/ramp_power" value="$(arg attack_ramp_power)" type="double"/>
    <param name="attack/max_vel_check" value="$(arg attack_max_vel_check)" type="double"/>
    <param name="attack/max_acc_check" value="$(arg attack_max_acc_check)" type="double"/>
    <param name="attack/max_jerk_check" value="$(arg attack_max_jerk_check)" type="double"/>

    <!-- Experiment CSV logger. -->
    <param name="experiment/log_enable" value="$(arg experiment_log_enable)" type="bool"/>
    <param name="experiment/log_file" value="$(arg experiment_log_file)" type="string"/>
    <param name="experiment/per_uav_log_file" value="$(arg experiment_per_uav_log_file)" type="string"/>
    <param name="experiment/per_uav_log_enable" value="$(arg experiment_per_uav_log_enable)" type="bool"/>
    <param name="experiment/timeseries_log_file" value="$(arg experiment_timeseries_log_file)" type="string"/>
    <param name="experiment/timeseries_log_enable" value="$(arg experiment_timeseries_log_enable)" type="bool"/>
    <param name="experiment/timeseries_interval" value="$(arg experiment_timeseries_interval)" type="double"/>
    <param name="experiment/scenario" value="$(arg experiment_scenario)" type="string"/>
    <param name="experiment/seed" value="$(arg experiment_seed)" type="int"/>
    <param name="experiment/swarm_size" value="$(arg experiment_swarm_size)" type="int"/>
    <param name="experiment/attacker_count" value="$(arg experiment_attacker_count)" type="int"/>

  </node>

</launch>
